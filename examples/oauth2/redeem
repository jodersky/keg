#!/bin/sh

redirect_uri=http://localhost:3000/login/generic_oauth
redirect_uri_encoded=$(printf '%s' "$redirect_uri" | jq -s -R -r @uri)
scope="openid profile roles email"
scope_encoded=$(printf '%s' "$scope" | jq -s -R -r @uri)

code_verifier="myrandomstring"
code_challenge=$(printf '%s' "$code_verifier" | openssl dgst -sha256 -binary | openssl base64 -e -A | tr '+/' '-_' | tr -d '=')
code_challenge_method="S256"

client_id="2b1c0644-716d-413c-80db-fcb0255e9d0d"
client_secret="3d777d2876a4b1475cb71ac3abdd20563c40e52915e06de423a873c4214d46d1"

url="http://localhost:8080/authorize?response_type=code&client_id=$client_id&redirect_uri=$redirect_uri_encoded&scope=$scope_encoded&state=1234&code_challenge=$code_challenge&code_challenge_method=$code_challenge_method"
echo "Open the following URL in your browser to authorize:"
echo "$url"
xdg-open "$url"

read -p "Enter the authorization code: " code

response=$(curl -X POST http://localhost:8080/token \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "grant_type=authorization_code" \
  -d "code=$code" \
  -d "redirect_uri=$redirect_uri" \
  -d "client_id=$client_id" \
  -d "client_secret=$client_secret" \
  -d "code_verifier=$code_verifier"
)

echo "Response from token endpoint:"
echo "$response" | jq .

echo "Decoded ID token payload:"
echo "$response" | jq -r .id_token | cut -d '.' -f 2 | base64 -d | jq .


echo "Getting userinfo with access token..."
access_token=$(echo "$response" | jq -r .access_token)
userinfo_response=$(curl -X GET http://localhost:8080/userinfo \
  -H "Authorization: Bearer $access_token"
)
echo "Response from userinfo endpoint:"
echo "$userinfo_response" | jq .

curl -X GET http://localhost:8080/userinfo \
  -H "Authorization: Bearer ${access_token}a"


