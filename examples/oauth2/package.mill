package build.examples.oauth2

import mill.*, mill.scalalib.*

object `package` extends build.ExampleModule:
  def mvnDeps = super.mvnDeps() ++ Seq(
    build.thirdparty.scalatags,
    build.thirdparty.caffeine,
    build.thirdparty.scribeSlf4j,
    mvn"io.crashbox::clip::0.2.1",
    mvn"io.crashbox::simplesql::0.4.0",
    mvn"org.xerial:sqlite-jdbc:3.51.3.0",
    mvn"de.mkammerer:argon2-jvm:2.12",
    mvn"com.lihaoyi::requests:0.9.0",
    mvn"com.yubico:webauthn-server-core:2.5.3",
    mvn"com.fasterxml.jackson.core:jackson-core:2.15.2"
  )

  def moduleDeps = super.moduleDeps ++ Seq(
    build.keg.extras
  )

  def forkArgs = Seq(
    "--enable-native-access=ALL-UNNAMED"
  )

  def forkEnv = super.forkEnv() ++ Map(
    "DEBUG" -> "true",
    "DB" -> (Task.ctx().workspace  / ".data" / "sso.db").toString
  )

  def image() = Task.Command {
    // need to copy this here so that it's part of the podman build context
    val jar = os.copy(assembly().path, Task.dest / "app.jar")

    val content =
      s"""
      FROM gcr.io/distroless/java25-debian13:nonroot
      COPY app.jar /app/app.jar
      ENTRYPOINT ["java", ${forkArgs().map(arg => s""""$arg"""").mkString(", ")}, "-jar", "/app/app.jar"]
      """
    os.write(Task.dest / "Containerfile", content)

    val tags = Seq(
      "sso:latest",
      "r.home.internal/sso:latest"
    )

    os.proc("podman", "build", tags.flatMap(t => Seq("-t", t)), Task.dest).call(stdout = os.Inherit)
    tags.last
  }

  def pushImage() = Task.Command {
    os.proc("podman", "push", image()()).call(stdout = os.Inherit)
  }

