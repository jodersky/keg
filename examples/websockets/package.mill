package build.examples.websockets

import mill.scalalib.*

object `package` extends build.UsageExampleModule with ScalaModule:
  def scalaVersion = build.scala3
  def moduleDeps = Seq(build.keg.jvm)
  def serverExecutable = assembly()

  object tests extends ScalaTests with build.KegTestModule:
    def mvnDeps = super.mvnDeps() ++ Seq(build.thirdparty.requests)
