import mill.*, scalalib.*, scalanativelib.*, scalafmt.*
import build.thirdparty
import mill.api.Task.Simple

val scala3 = "3.8.2"
val scalaNative = "0.5.10"

object keg extends ScalaModule with ScalafmtModule:
  def scalaVersion = scala3
  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked", "-encoding", "utf8", "-preview")

  def mvnDeps = Seq(
    thirdparty.slf4jSimple,
    thirdparty.upickle,
    thirdparty.undertow,
    thirdparty.castor,
    thirdparty.ustats,
    thirdparty.caffeine
  )

  object test extends ScalaTests:
    def testFramework = "utest.runner.Framework"
    def mvnDeps = Seq(
      thirdparty.utest,
      thirdparty.requests
    )

  def moduleDeps = Seq(forms)

  object forms extends ScalaModule with ScalafmtModule:
    def scalaVersion = scala3
    def scalacOptions = Seq("-deprecation", "-feature", "-unchecked", "-encoding", "utf8", "-preview")

     object test extends ScalaTests:
      def testFramework = "utest.runner.Framework"
      def mvnDeps = Seq(thirdparty.utest)

