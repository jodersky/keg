//| mill-version: 1.1.4
//| mvnDeps: ["com.lihaoyi::mill-contrib-jmh:$MILL_VERSION"]

import mill.*, scalalib.*, scalanativelib.*, scalafmt.*
import build.thirdparty

val scala3 = "3.8.2"
val scalaNative = "0.5.10"

trait KegMultiModule extends ScalaModule:
  def scalaVersion = scala3
  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked", "-encoding", "utf8", "-preview")
  def moduleDir = super.moduleDir / os.up
  def sources = Task.Sources(
    moduleDir / "src",
    moduleDir / "src-jvm",
  )

trait KegTestModule extends TestModule:
  def testFramework = "utest.runner.Framework"
  def mvnDeps = Seq(thirdparty.utest)

trait KegMultiNativeModule extends KegMultiModule with ScalaNativeModule:
  def scalaNativeVersion = scalaNative
  def sources = Task.Sources(
    moduleDir / "src",
    moduleDir / "src-native",
  )

object keg extends Module:
  val commonDeps = Seq(
    thirdparty.geny,
    thirdparty.castor,
    thirdparty.upickle
  )

  object jvm extends KegMultiModule:
    def moduleDeps = Seq(keg.forms.jvm)
    def mvnDeps = commonDeps ++ Seq(
      thirdparty.slf4jSimple,
      thirdparty.undertow
    )
    object test extends ScalaTests with KegTestModule:
      def mvnDeps = super.mvnDeps() ++ Seq(
        thirdparty.requests,
        thirdparty.oslib
      )
  object native extends KegMultiNativeModule:
    def moduleDeps = Seq(keg.forms.native)
    def mvnDeps = commonDeps ++ Seq(
      thirdparty.nativeCrypto,
      thirdparty.nativeTime
    )
    object test extends ScalaNativeTests with KegTestModule

  // As of now we don't have a good way to actually test uhttp in scalanative
  // with regular unit tests. The problem is that as of this writing there is
  // no good HTTP client for scalanative. Hence, we use this test, where the
  // server is compiled ahead of time with scalanative, and then tested with a
  // regular JVM test.
  object crosstest extends Module:
    object server extends ScalaNativeModule:
      def scalaVersion = scala3
      def scalaNativeVersion = scalaNative
      def moduleDeps = Seq(keg.native)
    object test extends ScalaModule with TestModule:
      def scalaVersion = scala3
      def forkEnv = Map("SERVER_EXECUTABLE" -> crosstest.server.nativeLink().path.toString)
      def testFramework = "utest.runner.Framework"
      def mvnDeps = Seq(
        thirdparty.utest,
        thirdparty.requests,
        thirdparty.oslib
      )

  object forms extends Module:
    object jvm extends KegMultiModule:
      object test extends ScalaTests with KegTestModule
    object native extends KegMultiNativeModule:
      object test extends ScalaNativeTests with KegTestModule

  object extras extends ScalaModule:
    def scalaVersion = scala3
    def moduleDeps = Seq(keg.jvm)
    def mvnDeps = Seq(
      thirdparty.ustats,
      thirdparty.caffeine
    )

object sandbox extends ScalaModule:
  def scalaVersion = scala3
  def moduleDeps = Seq(keg.jvm)

  def scalacOptions = Seq("-Xprint:postInlining", "-feature")

  def mvnDeps = Seq(thirdparty.scalatags)

