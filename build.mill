object examples extends Module:
  trait ExampleModule extends ScalaModule:
    def scalaVersion = scala3
    def moduleDeps = Seq(keg.jvm)
    def scalacOptions = Seq("-explain-cyclic")

    object test extends ScalaTests:
      def testFramework = "utest.runner.Framework"
      def mvnDeps = Seq(
        thirdparty.utest,
        thirdparty.requests
      )

  object oauth2 extends ExampleModule:
    def mvnDeps = super.mvnDeps() ++ Seq(
      thirdparty.scalatags,
      thirdparty.caffeine
    )
  object endpoints extends ExampleModule

  object reloader extends ExampleModule:
    def mvnDeps = super.mvnDeps() ++ Seq(
      thirdparty.scalatags
    )

  object forms extends ExampleModule
