#!/bin/bash
set -o errexit

# update readme
./mill readme

# run tests
./mill keg.__.test
# examples use fixed ports, so can't be run in parallel; however we can
# pre-build them in parallel to speed up the overall test process
./mill examples.__.assembly
./mill examples.__.nativeLink

# usage examples
./mill -j 1 examples.__.test

# some examples have actual tests (not just usage ones based on curl)
./mill examples.__.testForked
